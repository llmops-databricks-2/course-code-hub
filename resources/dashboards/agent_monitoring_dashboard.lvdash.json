{
  "datasets": [
    {
      "name": "04979a26",
      "displayName": "arxiv_traces_aggregated",
      "queryLines": [
        "SELECT * FROM arxiv_agent_monitoring_live"
      ]
    },
    {
      "name": "http_metrics",
      "displayName": "App HTTP metrics",
      "queryLines": [
        "SELECT time AS request_time,",
        "  try_cast(histogram.attributes:['http.route'] AS STRING) AS route,",
        "  try_cast(histogram.attributes:['http.request.method'] AS STRING) AS method,",
        "  try_cast(histogram.attributes:['http.response.status_code'] AS INT) AS status_code,",
        "  histogram.count AS request_count, histogram.sum AS duration_seconds",
        "FROM app_otel_metrics",
        "WHERE name = 'app.http.request.duration'",
        "  AND service_name = concat('agent-arxiv-curator-', regexp_replace(current_catalog(), '^llmops_', ''))"
      ]
    }
  ],
