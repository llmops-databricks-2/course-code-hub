            "name": "http-errors",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "http_metrics",
                  "fields": [
                    {
                      "name": "minutely(request_time)",
                      "expression": "DATE_TRUNC(\"MINUTE\", `request_time`)"
                    },
                    {
                      "name": "errors",
                      "expression": "SUM(CASE WHEN `status_code` >= 500 THEN `request_count` ELSE 0 END)"
